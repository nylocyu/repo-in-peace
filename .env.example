# Sign-in: an OAuth App (public repos only) or, for private repos, a GitHub App
# (https://github.com/settings/apps/new). Use the app's Client ID/secret here either way.
# Callback URL: <BASE_URL>/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BASE_URL=http://localhost:3000

# Optional, GitHub App only: enables private repos.
# Permissions: Repository > Metadata: read, Contents: read. Nothing else, no webhook needed.
# Private key: the .pem from the app settings, newlines as \n (keep it out of git).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=

# For the obituaries (without a key: README description + random cause of death)
ANTHROPIC_API_KEY=

# Optional: token for the hourly zombie check (otherwise max. 60 GitHub requests/h)
GITHUB_TOKEN=

# Local only: sign in with a username, no OAuth; ownership = owner name
DEV_LOGIN=1

# GitHub OAuth App: https://github.com/settings/developers -> New OAuth App
# Authorization callback URL: <BASE_URL>/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BASE_URL=http://localhost:3000

# For the obituaries (without a key: README description + random cause of death)
ANTHROPIC_API_KEY=

# Optional: token for the hourly zombie check (otherwise max. 60 GitHub requests/h)
GITHUB_TOKEN=

# Local only: sign in with a username, no OAuth; ownership = owner name
DEV_LOGIN=1

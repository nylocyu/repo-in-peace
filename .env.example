# Sign-in. Either an OAuth App (public repos only) or a GitHub App (also private repos, read-only).
# Callback URL: <BASE_URL>/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BASE_URL=http://localhost:3000

# GitHub App only: its slug (github.com/apps/<slug>), shows an "install on your repos" link in Settings.
# Permissions: Repository > Metadata: read, Contents: read. No webhook needed.
GITHUB_APP_SLUG=

# Supabase (Project Settings > API Keys). Create the tables once with supabase/schema.sql.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Encrypts the session cookie (the GitHub token lives only there) and the stored Claude keys.
# Generate: openssl rand -base64 32. Changing it signs everyone out and drops their stored keys.
SESSION_SECRET=

# Optional: comma-separated GitHub logins allowed to sign in. Empty = anyone with a GitHub account.
ALLOWED_USERS=

# Local only: sign in with a username, no OAuth; syncs that user's public repos
DEV_LOGIN=1
# Optional with DEV_LOGIN: token so the sync is not limited to 60 GitHub requests/h
GITHUB_TOKEN=
